{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.verificate/mcp",
  "description": "Agentic code review with veto: 17 deterministic reality gates + frontier-model deep review.",
  "title": "Verificate MCP",
  "repository": {
    "url": "https://github.com/Verificate-Dev/verificate-mcp-quickstart",
    "source": "github"
  },
  "version": "1.8.5",
  "websiteUrl": "https://verificate.ai/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.verificate.ai/mcp",
      "headers": [
        {
          "description": "Bearer <token> — from your Verificate dashboard (30-day free trial, no card: https://verificate.ai/auth/signup)",
          "isRequired": true,
          "isSecret": true,
          "name": "Authorization"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "https://verificate.ai/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://verificate.ai/icon-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    }
  ]
}
